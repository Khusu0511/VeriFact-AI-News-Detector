{
  "manifest_version": 3,
  "name": "Fake News Detector",
  "version": "1.2",
  "description": "Analyzes the headline on the current page and displays a result banner.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:3001/*",
    "http://localhost:3001/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "48": "icons/logo.png"
    }
  },
  "icons": {
    "48": "icons/logo.png"
  }
}